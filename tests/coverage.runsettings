<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings for every test project (issue #247), wired up through
     RunSettingsFilePath in Directory.Build.props. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Code the compiler generates for us, not code we write: the .NET 10 OpenAPI
               XML-comment generator and its interceptor attributes. -->
          <Exclude>[ClercqIt.Api]Microsoft.AspNetCore.OpenApi.Generated.*,[*]System.Runtime.CompilerServices.*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
