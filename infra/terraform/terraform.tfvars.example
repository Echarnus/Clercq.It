# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and fill in your actual values
# DO NOT commit terraform.tfvars to version control

# Scaleway Configuration
scaleway_organization_id = "your-scaleway-organization-id"
scaleway_project_id      = "your-scaleway-project-id"
scaleway_zone            = "fr-par-1"
scaleway_region          = "fr-par"

# Secret seeds: only used the first time each Secret Manager secret is
# created (see docs/secrets.md). Leave unset to generate passwords and get
# placeholders you replace in the Scaleway console.
keycloak_base_url            = "https://lemur-16.cloud-iam.com/auth"
keycloak_realm               = "clercqit"
keycloak_admin_client_secret = "your-clercqit-admin-client-secret"

# Application Configuration
container_image   = "echarnus/clercq-it:latest"
database_password = "your-secure-database-password"
environment       = "portfolio"

# =============================================================================
# Administration API Configuration
# =============================================================================

# Docker image for the Administration API
administration_container_image = "echarnus/clercq-it-administration:latest"

# Database user for Administration app (uses separate schema)
administration_database_user     = "admin_app_user"
administration_database_password = "your-secure-admin-database-password"
