# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and fill in your actual values
# DO NOT commit terraform.tfvars to version control

# Scaleway Configuration
scaleway_organization_id = "your-scaleway-organization-id"
scaleway_project_id      = "your-scaleway-project-id"
scaleway_zone            = "fr-par-1"
scaleway_region          = "fr-par"

# Object Storage Configuration
# These should be the same as your SCW_ACCESS_KEY and SCW_SECRET_KEY
# They are used for S3-compatible object storage access from the application container
scaleway_access_key = "your-scaleway-access-key"
scaleway_secret_key = "your-scaleway-secret-key"

# Cloud IAM Configuration
cloud_iam_api_url             = "https://api.cloud-iam.com"
cloud_iam_api_key             = "your-cloud-iam-api-key"
cloud_iam_client_redirect_url = "https://www.clercq.it"

# Authentication Configuration (deprecated - using Cloud IAM instead)
# jwt_secret_key = "your-jwt-secret-key-min-32-characters"

# Application Configuration
container_image     = "echarnus/clercq-it:latest"
database_password   = "your-secure-database-password"
custom_domain       = "www.clercq.it"  # Custom domain for the web application
environment         = "portfolio"
