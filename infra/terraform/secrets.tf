# =============================================================================
# Scaleway Secret Manager: single source of truth for application secrets
# =============================================================================
#
# Each secret is created here. Its first version is seeded once from the
# matching TF_VAR (still passed by the workflows from GitHub secrets during the
# migration) or, for passwords, generated by Terraform. After that the value is
# owned by Secret Manager: Terraform never overwrites it (ignore_changes), and
# everything reads the latest enabled version. To rotate a value, add a new
# version in the Scaleway console and run the infra pipeline.
# See docs/secrets.md.

locals {
  secret_path = "/clercq-it"

  # Every database connection requires TLS. The containers also pin the
  # instance certificate (Database__CaCertificate), which upgrades this to
  # VerifyCA in the API (docs/secrets.md#database-logins).
  db_connection_base = "Host=${scaleway_rdb_instance.portfolio_db.load_balancer.0.ip};Port=${scaleway_rdb_instance.portfolio_db.load_balancer.0.port};SSL Mode=Require"

  # Names only: for_each cannot iterate over sensitive values.
  secret_names = toset([
    "db-app-password",
    "keycloak-base-url",
    "myzen-session-key",
  ])

  # Seed values used only when a secret is created. Values that cannot be
  # generated fall back to a placeholder the owner replaces in the console.
  secret_seeds = {
    "db-app-password"   = coalesce(var.database_password, random_password.db_app.result)
    "keycloak-base-url" = coalesce(var.keycloak_base_url, "https://replace-me.cloud-iam.com/auth")
    "myzen-session-key" = random_password.myzen_session_key.result
  }

  # The runtime login's connection string (without the CA pin, which is a plain
  # variable). The website container gets it as an environment secret; the
  # scheduled jobs read the same value from the secret below (docs/jobs.md).
  db_runtime_connection = "${local.db_connection_base};Database=${scaleway_rdb_database.portfolio_app_db.name};Username=${scaleway_rdb_user.portfolio_runtime_user.name};Password=${random_password.db_runtime.result}"

  # Values read back from Secret Manager (latest enabled version).
  secrets = { for name, version in data.scaleway_secret_version.app : name => base64decode(version.data) }
}

# Scaleway RDB requires a digit, an upper, a lower and a special character.
# The specials are limited to ones that are safe unquoted in an Npgsql
# connection string (no ; = ' ") and in PGPASSWORD.
ephemeral "random_password" "db_admin" {
  length           = 32
  special          = true
  override_special = "!#%*-_+."
  min_special      = 1
  min_upper        = 1
  min_lower        = 1
  min_numeric      = 1
}

# Runtime database login (clercqit_app, main.tf). Terraform owns it end to
# end: a new random_password writes a new secret version.
resource "random_password" "db_runtime" {
  length           = 32
  special          = true
  override_special = "!#%*-_+."
  min_special      = 1
  min_upper        = 1
  min_lower        = 1
  min_numeric      = 1
}

resource "scaleway_secret" "db_runtime_password" {
  name        = "db-runtime-password"
  path        = local.secret_path
  region      = var.scaleway_region
  project_id  = var.scaleway_project_id
  description = "Clercq.It runtime database login clercqit_app (managed by infra/terraform/secrets.tf)"
  tags        = ["clercq-it", "terraform"]
}

resource "scaleway_secret_version" "db_runtime_password" {
  secret_id   = scaleway_secret.db_runtime_password.id
  region      = var.scaleway_region
  description = "Generated by Terraform (random_password.db_runtime)"
  data        = random_password.db_runtime.result
}

# The same login as a ready-made connection string, for the scheduled jobs: a
# Scaleway job reads its secrets from Secret Manager references, not from
# environment variables Terraform sets. Terraform owns it end to end.
resource "scaleway_secret" "db_runtime_connection" {
  name        = "db-runtime-connection"
  path        = local.secret_path
  region      = var.scaleway_region
  project_id  = var.scaleway_project_id
  description = "Connection string of the runtime database login clercqit_app, for scheduled jobs (managed by infra/terraform/secrets.tf)"
  tags        = ["clercq-it", "terraform"]
}

resource "scaleway_secret_version" "db_runtime_connection" {
  secret_id   = scaleway_secret.db_runtime_connection.id
  region      = var.scaleway_region
  description = "Generated by Terraform (local.db_runtime_connection)"
  data        = local.db_runtime_connection
}

resource "random_password" "db_app" {
  length  = 32
  special = false
}

# Encrypts the stored MyZen session cookies (docs/myzen.md). Rotating it only
# forces the owner to reconnect MyZen.
resource "random_password" "myzen_session_key" {
  length  = 48
  special = false
}

resource "scaleway_secret" "app" {
  for_each = local.secret_names

  name        = each.key
  path        = local.secret_path
  region      = var.scaleway_region
  project_id  = var.scaleway_project_id
  description = "Clercq.It ${each.key} (managed by infra/terraform/secrets.tf)"
  tags        = ["clercq-it", "terraform"]
}

resource "scaleway_secret_version" "seed" {
  for_each = local.secret_names

  secret_id   = scaleway_secret.app[each.key].id
  region      = var.scaleway_region
  description = "Initial value seeded by Terraform"
  data        = local.secret_seeds[each.key]

  lifecycle {
    # Secret Manager owns the value after the first apply.
    ignore_changes = [data, description]
  }
}

data "scaleway_secret_version" "app" {
  for_each = local.secret_names

  secret_id = scaleway_secret.app[each.key].id
  region    = var.scaleway_region
  revision  = "latest_enabled"

  depends_on = [scaleway_secret_version.seed]
}

# The owner's MyZen login (docs/myzen.md). The owner created this Username/password
# secret by hand, so Terraform only reads it: its value is JSON with "username"
# and "password". To change the login, add a new version in the console.
data "scaleway_secret" "myzen_login" {
  name       = "myzen-login"
  region     = var.scaleway_region
  project_id = var.scaleway_project_id
}

data "scaleway_secret_version" "myzen_login" {
  secret_id = data.scaleway_secret.myzen_login.id
  region    = var.scaleway_region
  revision  = "latest_enabled"
}

locals {
  myzen_login = jsondecode(base64decode(data.scaleway_secret_version.myzen_login.data))
}
