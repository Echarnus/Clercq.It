{
  "realm": "clercqit",
  "enabled": true,
  "displayName": "Clercq.It Local Development",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "Admin.View",
        "description": "Can view admin dashboard and settings"
      },
      {
        "name": "Blogs.Contributor",
        "description": "Can create, edit, and delete blog posts"
      },
      {
        "name": "Projects.Contributor",
        "description": "Can create, edit, and delete projects"
      },
      {
        "name": "Certifications.Contributor",
        "description": "Can create, edit, and delete certifications"
      }
    ]
  },
  "defaultRoles": [],
  "clients": [
    {
      "clientId": "clercqit-api",
      "name": "Clercq.It API",
      "description": "Backend API for Clercq.It",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "clercqit-api-secret-local",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "clercqit-web",
      "name": "Clercq.It Web Frontend",
      "description": "Next.js frontend for Clercq.It",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "clercqit-web-secret-local",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5000"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "clercqit-admin",
      "name": "Clercq.It Admin Client",
      "description": "Admin client for direct access grants and token exchange",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "clercqit-admin-secret-local",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "roles",
      "roles": [
        "Admin.View",
        "Blogs.Contributor",
        "Projects.Contributor",
        "Certifications.Contributor"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@clercq.it",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Admin.View",
        "Blogs.Contributor",
        "Projects.Contributor",
        "Certifications.Contributor"
      ]
    },
    {
      "username": "blogger",
      "email": "blogger@clercq.it",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Blog",
      "lastName": "Contributor",
      "credentials": [
        {
          "type": "password",
          "value": "blogger",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Admin.View",
        "Blogs.Contributor"
      ]
    },
    {
      "username": "projects",
      "email": "projects@clercq.it",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Project",
      "lastName": "Contributor",
      "credentials": [
        {
          "type": "password",
          "value": "projects",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Admin.View",
        "Projects.Contributor"
      ]
    },
    {
      "username": "certs",
      "email": "certs@clercq.it",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Certification",
      "lastName": "Contributor",
      "credentials": [
        {
          "type": "password",
          "value": "certs",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Admin.View",
        "Certifications.Contributor"
      ]
    },
    {
      "username": "test",
      "email": "test@clercq.it",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "OpenID Connect scope for add user roles to the access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${rolesScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "roles",
    "profile",
    "email"
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  }
}
